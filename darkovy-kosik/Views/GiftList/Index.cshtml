@model List<Item>
@{

    if (Model.Count > 0) {
        ViewData["Title"] = "Seznam přání " + ViewBag.Username;
    }
    else {
        ViewData["Title"] = "Seznam Prázdný :(";
    }
}

<div class="gifts">
    <!-- <div class="panel">
        <form asp-controller="GiftList" asp-action="Index" method="get" class="filter">
            <div class="group">
                <label for="sort">Řazení</label>
                <select id="sort" name="sort">
                    <option value="price_desc">Od Nejdražšího</option>
                    <option value="price_asc">Od Nejlevnějšího</option>
                </select>
            </div>
            
            <div class="group">
                <button type="submit">Filtrovat</button>
                <a asp-action="Index" class="button" type="cancel">Reset</a>
            </div>
        </form>
    </div> -->
    <div class="gifts_list">
        @for (int i = @Model.Count - 1; i >= 0; i--) {
            <div onclick="window.open('@Model[i].Link', '_blank')" class="item_card @(Model[i].IsReserved ? "reserved" : "") ">
                <img src="@Model[i].ImageUrl" class="item_photo"/>
                <span class="popis">
                    <h1>@Model[i].Name</h1>
                    <p class="cena">@Model[i].Price Kč</p>
                </span>
                @if (!Model[i].IsReserved) {
                    <button onclick="event.stopPropagation(); openModal(@Model[i].Id, @Model[i].UserId, '@Model[i].Link')" class="submit">Rezervovat</button>
                }
                else {
                    <p class="error">Tento dárek je již rezervován.</p>
                }
            </div>
        }
    </div>
</div>

<div id="reserveModal" class="modal-overlay">
    <div class="modal-card">
        <h2>Rezervovat dárek</h2>
        <p>Zadejte své jméno, aby ostatní věděli, že tento dárek už kupujete.</p>
        <p class="error">ODKAZ NA DÁREK SI ULOŽTE</p>
        <a class="button" type="link" id="modalLink" href="">Odkaz na dárek</a>
        
        <!-- Submit to a public controller method -->
        <form asp-controller="GiftList" asp-action="ReserveItem" method="post">
            <input type="hidden" id="modalItemId" name="itemId" />
            <input type="hidden" id="modalUserId" name="userId" />
            
            <div class="group">
                <label for="reserverName">Vaše jméno:</label>
                <input type="text" id="reserverName" name="reserverName" required />
            </div>
            
            <div class="modal-actions">
                <button type="button" class="delete" onclick="closeModal()">Zrušit</button>
                <button type="submit">Potvrdit rezervaci</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openModal(itemId, userId, link) {
        document.getElementById('modalItemId').value = itemId;
        document.getElementById('modalUserId').value = userId;
        document.getElementById('modalLink').href = link;
        
        document.getElementById('reserveModal').classList.add('show');
    }

    function closeModal() {

        document.getElementById('reserveModal').classList.remove('show');
        
        setTimeout(() => {
            document.getElementById('reserverName').value = '';
        }, 300);
    }
</script>