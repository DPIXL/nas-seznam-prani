@{
    ViewData["Title"] = "";
    @model List<User>;
}

@{
    string[] names = new string[] { "bvcbv", "Andy", "Maminka", "Anežka" };
}

<div class="card_container">
    @for (int i = 1; i <= @Model.Count; i++) {
        <a asp-controller="GiftList" asp-action="Index" asp-route-id=@i class="category_card" id="cat_card_@i">
            <h1>@Model[i-1].Name</h1>
        </a>
    }
</div>
